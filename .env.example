# Boilerplate secrets schema.
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# Then run `make secrets` (or just `make`, which depends on it) to regenerate
# `App/Sources/Generated/Secrets.swift` with values baked in.
#
# `.env` is gitignored. `.env.example` is committed and serves as documentation
# of which keys are expected.
#
# Conventions:
#   - Keys are SCREAMING_SNAKE_CASE; the generator converts to camelCase Swift identifiers
#     (e.g. EXAMPLE_API_KEY → Secrets.exampleApiKey)
#   - Values are taken literally; quote them only if the value itself includes the quotes
#   - Lines starting with `#` are ignored

# Example: third-party API key
EXAMPLE_API_KEY=

# Example: backend base URL
BACKEND_BASE_URL=
